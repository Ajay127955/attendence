# ─────────────────────────────────────────────────────────────
# Attendance Management System — server environment
# Copy to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Comma separated list of origins allowed by CORS.
# Production example: https://app.mydomain.com,https://www.app.mydomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# MongoDB — Atlas in production, local/Atlas in dev
MONGODB_URI=mongodb://127.0.0.1:27017/attendance_ams
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/attendance_ams?retryWrites=true&w=majority

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies (cross-subdomain: set COOKIE_DOMAIN=.mydomain.com and COOKIE_SECURE=true)
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Email (password reset). Leave SMTP_HOST empty to log reset links to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AMS <no-reply@mydomain.com>"

# Seed / demo accounts
SEED_ADMIN_EMAIL=admin@ams.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_TEACHER_PASSWORD=Teacher@12345
SEED_STUDENT_PASSWORD=Student@12345

# Google Sheets sync (optional). Set GOOGLE_SHEETS_ENABLED=true to mirror attendance.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────
# Single-origin deployment (recommended for a free sub-path link).
# Serve the built SPA from this same server so the app and API share an origin:
#   https://codestorm.dpdns.org/attendence/   → SPA
#   https://codestorm.dpdns.org/api/v1        → API
# No CORS allow-list and no cross-site cookies are needed.
# Build the client first:  cd client && npm run build
# ─────────────────────────────────────────────────────────────
SERVE_CLIENT=false
CLIENT_BASE_PATH=/attendence/
# Optional absolute path to the SPA build; defaults to ../client/dist
CLIENT_DIST=

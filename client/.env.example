# Client environment — copy to `.env`
# Leave VITE_API_URL empty in local dev to use the Vite proxy (recommended).
#
# ── Deployment ────────────────────────────────────────────────
# Single-origin (recommended, no CORS/cookie issues): the Express server serves
# this SPA itself, so the API is same-origin and VITE_API_URL stays empty.
#   VITE_BASE_PATH=/attendence/
#   VITE_API_URL=
#
# Split hosting (SPA on GitHub Pages/Vercel, API elsewhere):
#   VITE_BASE_PATH=/attendence/            # GitHub Pages project path
#   VITE_API_URL=https://api.example.com/api/v1
#   VITE_SOCKET_URL=https://api.example.com

# Sub-path the app is served from. "/attendence/" → https://host/attendence/
# Leave empty to serve from the site root.
VITE_BASE_PATH=

# API base URL. Empty = same origin (Vite proxy in dev, Express in single-origin prod).
VITE_API_URL=

# WebSocket origin for Socket.IO (defaults to the VITE_API_URL origin).
VITE_SOCKET_URL=

# Dev proxy target for `npm run dev` (the Express server).
VITE_PROXY_TARGET=http://localhost:5000
